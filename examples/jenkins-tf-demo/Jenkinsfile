// Jenkins + Terraform demo: deploy REAL resources, then notify the Observability Agent
// (custom DevOps Agent) which reviews CloudWatch alarm coverage and returns recommendations.
//
// Flow: terraform init -> apply (real t3.micro + S3) -> show -json -> slim payload ->
//       HMAC-signed POST to the Agent Space webhook -> event trigger fires the custom agent.
//
// This is tool-agnostic by design: the only Jenkins-specific part is how the two secrets
// are injected. The same shell runs in GitHub Actions / GitLab / CodeBuild unchanged.
//
// PREREQUISITES (see README.md):
//   - Jenkins agent has: terraform, aws cli, jq, openssl  (the demo Dockerfile installs them)
//   - AWS credentials available to terraform (env vars or mounted ~/.aws)
//   - An EVENT TRIGGER exists on the custom agent, pointed at the webhook, filter
//     resources[?action=='create']  (you create this once in the DevOps Agent console)
//   - Jenkins credentials: webhook-url (WEBHOOK_URL), webhook-secret (WEBHOOK_SECRET)

pipeline {
  agent any

  parameters {
    string(name: 'AWS_REGION',  defaultValue: 'us-east-1',        description: 'AWS region to deploy into')
    string(name: 'STACK_NAME',  defaultValue: 'obs-agent-demo',   description: 'Label used in the agent payload')
    booleanParam(name: 'DESTROY_AFTER', defaultValue: false,      description: 'Run terraform destroy at the end (clean up the demo resources)')
  }

  environment {
    WEBHOOK_URL    = credentials('webhook-url')      // Jenkins "Secret text" credential ID
    WEBHOOK_SECRET = credentials('webhook-secret')   // Jenkins "Secret text" credential ID
    // AWS creds: provide via Jenkins AWS credentials binding or mounted ~/.aws (see README).
    // When checked out via SCM, main.tf lives in this subfolder of the repo, not the
    // workspace root — all terraform/jq steps run inside it.
    TF_DIR = 'examples/jenkins-tf-demo'
  }

  stages {

    stage('Terraform Init') {
      steps {
        dir("${TF_DIR}") {
          sh 'terraform init -input=false -no-color'
        }
      }
    }

    stage('Terraform Apply (real resources)') {
      steps {
        dir("${TF_DIR}") {
          sh '''
            # Plan FIRST so the plan JSON captures the "create" actions. If we applied
            # first, the subsequent plan would be a no-op (resources already exist) and
            # the agent payload would be empty. Order matters here.
            terraform plan -input=false -no-color -var "region=${AWS_REGION}" -out=tfplan.bin
            terraform show -json tfplan.bin > plan.json
            # Now apply the exact plan we just captured.
            terraform apply -input=false -no-color -auto-approve tfplan.bin
            # Capture post-apply STATE as JSON — this is where real ARNs live (ARNs are
            # computed, so they are unknown at plan time; only state has them). The Notify
            # stage merges these ARNs onto each resource by its Terraform address.
            terraform show -json > state.json
          '''
        }
      }
    }

    stage('Notify Observability Agent') {
      steps {
        dir("${TF_DIR}") {
        sh '''
          # The webhook expects the fixed INCIDENT event schema (eventType "incident",
          # incidentId, action created|updated|closed|resolved, priority, title,
          # description, timestamp, service, and a free-form `data` object). Our custom
          # deployment/resource details go INSIDE `data` — a top-level custom shape like
          # eventType:"deployment" is rejected. The slim resource list keeps us under 10K.
          # Build the payload: slim the plan's CREATE resources, then MERGE each
          # resource's real ARN (from post-apply state) onto its own config, keyed by
          # Terraform address. ARNs are computed-after-apply, so they only exist in
          # state.json, not plan.json. Attaching per-resource (not a flat outputs blob)
          # means the agent never has to guess which ARN belongs to which resource.
          jq -n \
            --slurpfile plan plan.json \
            --slurpfile state state.json \
            --arg stack "${STACK_NAME}" \
            --arg region "${AWS_REGION}" \
            --arg ts "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" \
            '# address -> arn lookup from post-apply state
             (($state[0].values.root_module.resources // [])
               | map(select(.mode == "managed") | {key: .address, value: .values.arn})
               | from_entries) as $arns
             | ($plan[0].resource_changes
               | map(select(.change.actions[0] == "create")
                   | .address as $addr
                   | {
                       address: $addr,
                       type: .type,
                       action: .change.actions[0],
                       # slim the plan config, then attach THIS resource's real ARN
                       # (looked up by address via $addr), then drop any null fields.
                       config: ((.change.after
                           | {instance_type, instance_class, allocated_storage,
                              engine, engine_version, identifier, memory_size, timeout,
                              runtime, function_name, load_balancer_type, name,
                              node_type, num_cache_nodes, volume_size, ebs_volume_size,
                              instance_count, tags})
                         + {arn: $arns[$addr]}
                         | with_entries(select(.value != null)))
                     })) as $resources
             | {
                 eventType: "incident",
                 incidentId: ("tf-" + $stack + "-" + ($ts | gsub("[^0-9]";""))),
                 action: "created",
                 priority: "MEDIUM",
                 title: ("Pre-deploy alarm coverage review: " + $stack),
                 description: ("Terraform deployment of " + ($resources | length | tostring) + " resource(s) in " + $region + ". review_type=predeploy_observability. Review CloudWatch alarm coverage for the created resources and return recommendations."),
                 timestamp: $ts,
                 service: "Terraform",
                 data: {
                   review_type: "predeploy_observability",
                   source: "terraform",
                   stack: $stack,
                   region: $region,
                   resources: $resources
                 }
               }' > slim_payload.json

          echo "Slim payload size: $(wc -c < slim_payload.json) chars (limit 10000)"

          # Must match the server's expected ISO-8601 WITH milliseconds (e.g.
          # 2026-10-14T21:37:34.000Z). JavaScript's toISOString() — used by the
          # reference alarm-ingestion signer — always includes .000.
          TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")

          # CRITICAL: the bytes we SIGN must equal the bytes we SEND. jq writes the
          # file with a trailing newline. "$(cat file)" in a command substitution
          # STRIPS that trailing newline, but --data-binary @file KEEPS it — so
          # signing $(cat ...) while sending the file signs 1 fewer byte than it
          # sends → signature mismatch → 403. Fix: build the exact signing input
          # (timestamp + ":" + raw file bytes) in a file with no added/removed
          # bytes, sign THAT file, and send the same payload file unchanged.
          : > sign_input.bin
          printf "%s:" "$TIMESTAMP" >> sign_input.bin
          cat slim_payload.json      >> sign_input.bin
          SIGNATURE=$(openssl dgst -sha256 -hmac "$WEBHOOK_SECRET" -binary sign_input.bin | base64)

          HTTP_CODE=$(curl -sS -o agent_resp.txt -w "%{http_code}" \
              -X POST "$WEBHOOK_URL" \
              -H "Content-Type: application/json" \
              -H "x-amzn-event-timestamp: $TIMESTAMP" \
              -H "x-amzn-event-signature: $SIGNATURE" \
              --data-binary @slim_payload.json)

          echo "Webhook responded HTTP $HTTP_CODE"
          cat agent_resp.txt || true
          echo
          case "$HTTP_CODE" in
            2*) echo "Review triggered. Open the custom agent's run history to see the recommendations." ;;
            *)  echo "Webhook rejected (HTTP $HTTP_CODE). Check: trigger exists, secret matches, payload <10K, signature bytes match." ; exit 1 ;;
          esac
        '''
        }
      }
    }

    stage('Archive payloads') {
      steps {
        // archiveArtifacts needs a workspace/node context, so it lives in a stage
        // (not in the pipeline-level post block, which has no node → FilePath error).
        // The payload files are written inside TF_DIR, so reference them there.
        archiveArtifacts artifacts: "${TF_DIR}/slim_payload.json, ${TF_DIR}/plan.json", allowEmptyArchive: true
      }
    }

    stage('Teardown (optional)') {
      when { expression { return params.DESTROY_AFTER } }
      steps {
        dir("${TF_DIR}") {
          sh 'terraform destroy -auto-approve -input=false -no-color -var "region=${AWS_REGION}"'
        }
      }
    }
  }

  post {
    always {
      echo 'Done. If DESTROY_AFTER was false, remember to run terraform destroy to avoid charges.'
    }
  }
}
